{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Koin",
  "version": "0.3.0",
  "identifier": "com.aprisyourlie.koin",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Koin · 看清每个月的钱花在哪里",
        "width": 1260,
        "height": 820,
        "minWidth": 400,
        "minHeight": 540,
        "backgroundColor": "#f7f9f6"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
